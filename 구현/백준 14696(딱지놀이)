# 백준 14696(딱지놀이)

n = int(input())

for i in range(n):
    # 입력 받기
    a = list(map(int, input().split()))
    b = list(map(int, input().split()))
    # 카드 수 체크 배열
    achk = [0 for j in range(5)]
    bchk = [0 for j in range(5)]
    
    # 카드 수 체크
    for j in range(1, len(a)):
        achk[a[j]] += 1
    for j in range(1, len(b)):
        bchk[b[j]] += 1

    # 별(4) 동그라미(3) 네모(2) 세모(1)
    sw = 0
    for j in range(4, 0, -1):
        if achk[j] > bchk[j]:
            print("A")
            sw = 0
            break
        elif achk[j] < bchk[j]:
            sw = 0
            print("B")
            break
        else:
            sw = 1
    if sw == 1:
        print("D")
